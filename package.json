{
  "name": "dsh-web-search-provider",
  "description": "Improve web search in Deepseek Harness, use server-side search service.",
  "version": "0.2.2",
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiyms/dsh-web-search-provider.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-search",
    "responses-api",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "clean": "rm -rf lib",
    "prepare": "tsc -p tsconfig.json && tsdown",
    "prepublishOnly": "pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2 || ^0.1.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "^0.82.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "imports": {
    "#package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
